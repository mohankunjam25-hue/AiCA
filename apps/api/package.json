{
  "name": "@aica/api",
  "version": "1.0.0",
  "description": "Express.js REST API Gateway for AI Code Evolution Lab",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
